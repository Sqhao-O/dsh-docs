{
  "name": "dsh-doc",
  "version": "0.1.0",
  "description": "Local PDF, Office, image, and OCR document intelligence for DeepSeek Harness.",
  "license": "MIT",
  "homepage": "https://github.com/Sqhao-O/dsh-docs#readme",
  "bugs": {
    "url": "https://github.com/Sqhao-O/dsh-docs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sqhao-O/dsh-docs.git"
  },
  "packageManager": "pnpm@10.33.4",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "INSTALL.md",
    "docs",
    "python/worker.py",
    "python/README.md",
    "python/requirements/win32-x64.txt",
    "scripts",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepare": "pnpm run build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "test:nocov": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:e2e": "vitest run test/e2e",
    "runtime:build": "node scripts/build-runtime-win32-x64.mjs",
    "runtime:fetch": "node scripts/fetch-runtime-win32-x64.mjs",
    "runtime:verify": "node scripts/verify-runtime-win32-x64.mjs",
    "pack:check": "pnpm pack --pack-destination .pack"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "document-intelligence",
    "xberg",
    "ocr",
    "pdf",
    "office"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@xberg-io/xberg": "1.0.14"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.18.12",
    "@vitest/coverage-v8": "^4.0.8",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^4.0.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
